<launch>

<rosparam file="$(find robotics_arm_urdf)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="very" args="joint1_position_controller joint2_position_controller joint3_position_controller joint4_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/very/joint_states"/>
</node>

</launch>